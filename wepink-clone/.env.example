# ======================================================
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env — ele já está no .gitignore.
# ======================================================

# --- Banco de Dados (local) ---
DB_ROOT_PASSWORD=rootpass
DB_USER=user
DB_PASSWORD=pass

# --- Mercado Pago OAuth ---
# Obtidos em: https://www.mercadopago.com.br/developers/panel/app
# Crie uma aplicação, vá em "Credenciais" e copie o App ID e Secret.
MP_APP_ID=SEU_APP_ID_AQUI
MP_CLIENT_SECRET=SEU_CLIENT_SECRET_AQUI
MP_REDIRECT_URI=http://localhost/api/auth/mercadopago/callback

# --- Segredos de Aplicação ---
# JWT_SECRET: string aleatória com pelo menos 32 caracteres
JWT_SECRET=troque-por-uma-chave-secreta-forte-aqui
# ENCRYPTION_KEY: deve ter EXATAMENTE 32 caracteres (AES-256)
ENCRYPTION_KEY=32-chars-chave-aqui-completa!!!
